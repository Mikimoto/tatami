          "甲|乙"
        ]
      },
      {
        "label": "M",
        "match": [
          "app",
          "MM"
        ]
      },
      {
        "label": "Z",
        "match": [
          "app",
          "ZZ"
        ]
      }
    ],
    "default": "開發",
    "profiles": {
      "開發": {
        "trees": {
          "main": {
            "axis": "vertical",
            "children": [
              {
                "window": "A"
              },
              {
                "window": "B"
              }
            ]
          },
          "second": {
            "window": "C",
            "ratio": 0.75
          }
        }
      },
      "會議": {
        "exile": [
          "main",
          "second"
        ],
        "windows": [
          {
            "label": "M",
            "match": [
              "app",
              "MM"
            ]
          }
        ],
        "trees": {
