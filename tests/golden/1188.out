{
  "home": {
    "desc": "C+D",
    "displays": {
      "main": "BBBB-MAIN",
      "second": "BBBB-CHAT"
    },
    "exile": [
      "main"
    ],
    "windows": [
      {
        "label": "A",
        "match": [
          "app",
          "AA"
        ]
      },
      {
        "label": "B",
